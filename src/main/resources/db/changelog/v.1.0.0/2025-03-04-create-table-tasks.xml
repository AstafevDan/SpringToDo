<?xml version="1.0" encoding="UTF-8" ?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="2025-03-04-create-table-tasks" author="AstafevDan">
        <preConditions>
            <not>
                <tableExists tableName="tasks"/>
            </not>
        </preConditions>
        <createTable tableName="tasks" remarks="Таблица задач">
            <column name="id" type="bigserial" autoIncrement="true" remarks="Уникальный идентификатор задачи">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="varchar(64)" remarks="Название задачи">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text" remarks="Описание задачи"/>
            <column name="status" type="varchar(32)" remarks="Статус задачи">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="varchar(32)" remarks="Приоритет задачи">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="NOW()" remarks="Дата и время создания записи"/>
            <column name="last_modified_at" type="timestamp" defaultValue="NOW()" remarks="Дата и время обновления записи"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
